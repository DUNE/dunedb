    "bootstrap": "^4.6.2",
    "connect-mongo": "^5.1.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "passport": "^0.7.0",
    "passport-auth0": "^1.4.4",
    "pino": "^9.7.0",
    "pug": "^3.0.3",
    "sass": "^1.89.2",
    "short-uuid": "^5.2.0",
    "uuid-mongodb": "^2.6.0"
  },
  "devDependencies": {
    "jest": "^27.0.6",
    "supertest": "^6.1.3"
  },
  "nodemonConfig": {
