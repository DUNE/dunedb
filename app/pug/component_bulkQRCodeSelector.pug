extend default

block vars
  - const page_title = 'View Component QR Codes in Bulk';

block extrascripts
  block workscripts 
    script(src = '/pages/component_bulkQRCodeSelector.js')

block content
  .container-fluid
    .vert-space-x2
      h2 View Component QR Codes in Bulk

    .vert-space-x2 
      hr

      .row
        .col-md-3
          h4 Select Component Type

          .vert-space-x1
            p Select a component type below.
              br
              | <b>This is a <u>required</u> parameter.</b>

          select.form-control#typeFormSelection
            option(value = '')          
            option(value = 'CableHarness') Cable Harness
            option(value = 'CEAdapterBoard') CE Adapter Board
            option(value = 'CRBoard') CR Board
            option(value = 'GBiasBoard') G-Bias Board
            option(value = 'GeometryBoard') Geometry Board
            option(value = 'SHVBoard') SHV Board

          .vert-space-x2
            button.btn-primary.btn-lg#confirmButton View QR Codes

        .col-md-1 

        .col-md-3
          h4 Enter First Type Record Number

          .vert-space-x1
            p Enter the first type record number below.
              br
              | <b>This is a <u>required</u> parameter.</b>

          input.form-control#firstTypeRecordNumberSelection

        .col-md-1 

        .col-md-3
          h4 Enter Last Type Record Number

          .vert-space-x1
            p Enter the last type record number below.
              br
              | <b>This is a <u>required</u> parameter.</b>

          input.form-control#lastTypeRecordNumberSelection

        .col-md-1 

    .vert-space-x2
