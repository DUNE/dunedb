extend default

block vars
  - const page_title = 'Search for Actions by ID or Referenced UUID';

block extrascripts
  block workscripts
    script(src = '/pages/search_actionsByIDOrReferencedUUID.js')

block content
  .container-fluid
    .vert-space-x2
      h2 Search for Actions by ID or Referenced UUID

    .vert-space-x2 
      hr

      .row 
        .col-md-5
          .row
            .col-md-12
              h4 Search by Action ID

              .vert-space-x1
                p Enter an action ID below.

              .vert-space-x1
                #actionidform

          hr

          .row 
            .col-md-12
              h4 Search by Referenced Component UUID

              .vert-space-x1
                p Enter a component UUID below or take a picture of the component's QR code.

              .vert-space-x1 
                #componentuuidform

              .vert-space-x2
                p Select an action type below.

                select.form-control#actionTypeSelection
                  option(value = '')          
                  option(value = 'boardInstall') Board Installation (any layer, any side, any position) [Geometry Boards]
                  option(value = 'winding') Winding (any layer) [Wire Bobbins]

              .vert-space-x2
                button.btn-primary.btn-lg#confirmButton Search by Action Type and UUID

        .col-md-1

        .col-md-6
          h4 Search Results

          .vert-space-x1
            table#results

    .vert-space-x2
