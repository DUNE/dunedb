extend default

block vars
  - const page_title = 'Search for Workflows by ID or UUID';

block extrascripts
  block workscripts
    script(src = '/pages/search_workflowsByIDOrUUID.js')

block content
  .container-fluid
    .vert-space-x2
      h2 Search for Workflows by ID or UUID

    .vert-space-x2 
      hr

      .row
        .col-md-5 
          h4 Search by Workflow ID

          .vert-space-x1
            p Enter a workflow ID below.

          .vert-space-x1
            #workflowidform

        .col-md-1 

        .col-md-5
          h4 Search by Component UUID 

          .vert-space-x1
            p Enter a component UUID below or take a picture of the component's QR code.

          .vert-space-x1
            #componentuuidform

      .vert-space-x1
        #messages

    .vert-space-x2
