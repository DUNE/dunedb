extend default
include common.pug

block vars
  - const page_title = `Executive Summary: ${collatedInfo.assembledAPA.componentName}`;

block extrascripts
  script(type = 'text/javascript').
    const collatedInfo = !{JSON.stringify(collatedInfo, null, 4)};

  block workscripts
    script(src = '/pages/component_execSummary.js')

block allbody
  .vert-space-x2.hori-space-x1.noprint
    a.btn.btn-primary(onclick = 'window.print(); return false;' href = '#print') Print Executive Summary

    .vert-space-x1
      p For best display, please print <b>without headers and footers</b> and <b>with backgrounds</b>.

    .vert-space-x2
      hr

  .vert-space-x2
    .row
      .col-sm-8
        h1 Executive Summary: #{collatedInfo.assembledAPA.componentName}

        .vert-space-x1.hori-space-x1.h4
          dl
            dt APA Construction DB Component UUID
            dd
              a(href = `/component/${collatedInfo.assembledAPA.componentUUID}`, target = '_blank') #{collatedInfo.assembledAPA.componentUUID}

            dt DUNE PID
            dd #{collatedInfo.assembledAPA.dunePID}

            dt Production Site
            dd #{collatedInfo.assembledAPA.productionSite}

            dt Configuration
            dd #{collatedInfo.assembledAPA.configuration}

            dt Assembly Completion [%]

            if ((collatedInfo.assembledAPA.assemblyStatus) === -99.9)
              dd [no associated workflow]
            else if ((collatedInfo.assembledAPA.assemblyStatus) === -0.9)
              dd [not found in workflow]
            else
              dd
                a(href = `/workflow/${collatedInfo.assembledAPA.workflowID}`, target = '_blank') #{collatedInfo.assembledAPA.assemblyStatus.toFixed(2)}

        .vert-space-x1.hori-space-x1
          p &nbsp; This document was generated on 
            +dateTimeFormat(new Date())
            |  (all times are given in GMT)

      .col-sm-4
        #qr-code
          +qr-panel-noLabel(`${base_url}/c/${collatedInfo.assembledAPA.shortUUID}`)

    hr

  .vert-space-x2
    .entry_qcSignoffs
      .form_entry_qcSignoffs(data-record = [collatedInfo.frameConstruction, collatedInfo.framePreparation, collatedInfo.x, collatedInfo.v, collatedInfo.u, collatedInfo.g, collatedInfo.coverBoardsAndCaps, collatedInfo.postProduction, collatedInfo.completedAPA])

  .pagebreak

  .vert-space-x2
    .entry_wireLayer
      .form_entry_wireLayer(data-record = ['X', collatedInfo.x])

  .vert-space-x2 
    hr

  .vert-space-x2
    .entry_wireLayer
      .form_entry_wireLayer(data-record = ['V', collatedInfo.v])

  .pagebreak

  .vert-space-x2
    .entry_wireLayer
      .form_entry_wireLayer(data-record = ['U', collatedInfo.u])

  .vert-space-x2 
    hr

  .vert-space-x2
    .entry_wireLayer
      .form_entry_wireLayer(data-record = ['G', collatedInfo.g])

  .pagebreak

  .vert-space-x2
    .header_ncr 
      .form_header_ncr(data-record = 'Use As Is (Missing or Shorted Wires)')

    if collatedInfo.ncrs_useAsIs_withWires.length > 0
      each ncrInfo, ncrIndex in collatedInfo.ncrs_useAsIs_withWires
        .vert-space-x1 
          .entry_ncr
            .form_entry_ncr(data-record = ncrInfo)

            each wireInfo, wireIndex in ncrInfo.missingShortedWires
              .entry_ncrWire
                .form_entry_ncrWire(data-record = wireInfo)
    else 
      p [no non-conformances found with this disposition and NCR type(s)]

    .vert-space-x2
      hr

  .vert-space-x2
    .header_ncr 
      .form_header_ncr(data-record = 'Use As Is (Other NCR Types)')

    if collatedInfo.ncrs_useAsIs_noWires.length > 0
      each ncrInfo, ncrIndex in collatedInfo.ncrs_useAsIs_noWires
        .vert-space-x1 
          .entry_ncr
            .form_entry_ncr(data-record = ncrInfo)
    else 
      p [no non-conformances found with this disposition and NCR type(s)]

    .vert-space-x2
      hr

  .vert-space-x2
    .header_ncr 
      .form_header_ncr(data-record = 'Rework')

    if collatedInfo.ncrs_rework.length > 0
      each ncrInfo, ncrIndex in collatedInfo.ncrs_rework
        .vert-space-x1 
          .entry_ncr
            .form_entry_ncr(data-record = ncrInfo)
    else 
      p [no non-conformances found with this disposition]

    .vert-space-x2
      hr

  .vert-space-x2
    .header_ncr 
      .form_header_ncr(data-record = 'Repair')

    if collatedInfo.ncrs_repair.length > 0
      each ncrInfo, ncrIndex in collatedInfo.ncrs_repair
        .vert-space-x1 
          .entry_ncr
            .form_entry_ncr(data-record = ncrInfo)
    else 
      p [no non-conformances found with this disposition]

    .vert-space-x2
      hr
