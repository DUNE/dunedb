extend default

block vars
  - const page_title = 'Search for Assembled APAs by Production Details';

block extrascripts
  script(type = 'text/javascript').
    const dictionary_locations = !{JSON.stringify(dictionary_locations, null, 4)};

  block workscripts 
    script(src = '/pages/search_apasByProductionDetails.js')

block content
  .container-fluid
    .vert-space-x2
      h2 Search for Assembled APAs by Production Details

    .vert-space-x1
      .panel.panel-default
      .foldable-heading.panel-heading.collapsed(data-toggle = 'collapse' data-target = '#descriptionBox')
        | Description: 
        i.chevron.fa.fa-fw 

      .collapse#descriptionBox
        p This page may be used to search for <b>assembled APAs</b> by one of the following methods:
        ul
          li <b>by <u>production number</u></b> (the order in which the APAs have been assembled at a specified production location)
          li <b>by the <u>last completed QA action</u></b>

        p The <b><u>production location</u></b> is a required parameter for both scenarios - this <b>must</b> be selected from the associated dropdown menu.  Users may then either manually enter an (integer) production number, or select one of the QA action types from the associated dropdown menu.

        p If searching by production number, if the specified information corresponds to a single Assembled APA component record in the database, the user will be automatically redirected to the corresponding component information page.
          br
          |  If there is no such APA, i.e. the information does not match an existing component record, a message will be displayed in the results panel below the input selections.
          br
          |  It should not be possible for multiple APA component records to match against both the production location and production number, since they should together uniquely identify a single APA.  In the unlikely case of this situation occurring, a message will also be displayed indicating so.

        p If searching by the last completed QA action, a list of all Assembled APAs that have been produced at the specified location and completed up to <u>and including</u> that QA action will be displayed in the results panel below the input selections.  Alongside this, a list of Assembled APAs that have <b>not</b> had the specified QA action completed will also be displayed.

    .vert-space-x2
      hr

      .row
        .col-md-4
          h4 Select Production Location

          .vert-space-x1
            p
            | Select a production location below.<br>
            | <b>This is a <u>required</u> parameter for both searches.</b>

          .vert-space-x1
            select.form-control#locationSelection
              option(value = '')          
              option(value = 'chicago') #{dictionary_locations['chicago']} 
              option(value = 'daresbury') #{dictionary_locations['daresbury']} 
              option(value = 'wisconsin') #{dictionary_locations['wisconsin']} 

        .col-md-4
          h4 Search by Production Number

          .vert-space-x1
            p 
            | Enter an APA production number below.<br>
            | <b>This is a <u>required</u> parameter.</b>

          .vert-space-x1
            input.form-control#numberSelection

          .vert-space-x2
            button.btn-primary.btn-lg#confirmButton_number Search by Production Number

        .col-md-4
          h4 Search by Last Completed QA Action

          .vert-space-x1
            p 
            | Select a QA action type below.<br>
            | <b>This is an <u>alternative required</u> parameter.</b>

          .vert-space-x1
            select.form-control#assemblyStepSelection
              option(value = '')
              option(value = 'framePreparation') Frame Preparation QA Check
              option(value = 'xLayerAssembly') X Layer QA Check
              option(value = 'vLayerAssembly') V Layer QA Check
              option(value = 'uLayerAssembly') U Layer QA Check
              option(value = 'gLayerAssembly') G Layer QA Check
              option(value = 'coverBoardsAndCaps') Cover Boards / Cap Installation QA Check
              option(value = 'assemblyComplete') Completed APA QA Checklist

          .vert-space-x2
            button.btn-primary.btn-lg#confirmButton_assemblyStep Search by Last Completed QA Action

      .vert-space-x2 
        hr

      .vert-space-x1
        h4 Search Results 

        .vert-space-x1 
          #messages

        .row 
          .col-md-6.vert-space-x1
            #summary1 

            .row 
              .col-md-4
                table.results-table#results11 

              .col-md-1
              .col-md-4
                table.results-table#results12

              .col-md-3

          .col-md-6.vert-space-x1
            #summary2 

            .row 
              .col-md-4
                table.results-table#results21 

              .col-md-1
              .col-md-4
                table.results-table#results22

              .col-md-3

    .vert-space-x2
