extend default
include common.pug

block vars
  - const page_title = 'Actions List (All Types)';

block content
  .container-fluid
    .vert-space-x2
      h2 Actions List (All Types)

    .vert-space-x1
      table.table
        thead
          tr
            th.col-md-2 Action Type
            th.col-md-3 Performed on Component:
            th.col-md-1
            th.col-md-2 Last Performed On:
            th.col-md-1

        tbody
          each action in actions
            if !allActionTypeForms[action.typeFormId].tags.includes('Trash')
              - const uuid = MUUID.from(action.componentUuid).toString();

              tr
                td
                  a(href = `/action/${action.actionId}`) #{action.typeFormName}
                td
                  a(href = `/component/${uuid}`) #{action.componentName}
                td
                td
                  +dateTimeFormat(action.recordDate)
                td
                  a.btn-sm.btn-secondary(href = `/json/action/${action.actionId}`, target = '_blank')
                    img.small-icon(src = '/images/checklist_icon.svg')
                    | &nbsp; JSON
    .vert-space-x2
